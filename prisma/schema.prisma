generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Goal {
  id        Int      @id @default(autoincrement())
  title     String
  progress  Int      @default(0)
  status    String   @default("Đang thực hiện")
  createdAt DateTime @default(now())
}