generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Goal {
  id        Int      @id @default(autoincrement())
  title     String
  progress  Int      @default(0)
  status    String   @default("Đang thực hiện")
  createdAt DateTime @default(now())
}